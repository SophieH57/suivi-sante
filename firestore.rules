rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seul le compte Google de l'utilisatrice (uid ci-dessous) peut lire et écrire, et seulement users/{son uid} et en dessous.
    // Tout autre compte qui se connecte à l'appli est refusé (pas de consommation du quota par des inconnus).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && uid == 'oO20j6kOswNFOf6kcvSpOQAmY592';
    }
  }
}
